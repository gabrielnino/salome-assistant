# DeepSeek API — https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rutas de herramientas (ajusta si es necesario)
ADB_PATH=C:\Users\luisg\Desktop\scrcpy-win64-v3.3.4\scrcpy-win64-v3.3.4\adb.exe
SCRCPY_PATH=C:\Users\luisg\Desktop\scrcpy-win64-v3.3.4\scrcpy-win64-v3.3.4\scrcpy.exe

# Configuración de audio
WHISPER_MODEL=small
SAMPLE_RATE=16000
SILENCE_THRESHOLD_DB=-35
CHUNK_SECONDS=4
